# Panel — settings and keys
#
# Never put real keys in this file or in GitHub. Real keys go in:
#   Netlify → your site → Site configuration → Environment variables
#
# Add each service's keys only when we connect that service.

# ── Weather (works now, no key needed) ───────────────────────────────────────
# Optional: change the forecast location (defaults to San Clemente)
WEATHER_LAT=33.4270
WEATHER_LON=-117.6120
WEATHER_LOCATION_NAME=San Clemente

# ── 1. Rachio ──  Rachio app → Account → API Access
RACHIO_API_KEY=

# ── 2. Todoist ──  Todoist → Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=
TODOIST_PROJECT_ID=

# ── 3. Google (Calendar + Nest share one Google Cloud project) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
NEST_PROJECT_ID=

# ── 4. Philips Hue ──  developers.meethue.com
HUE_CLIENT_ID=
HUE_CLIENT_SECRET=
HUE_REFRESH_TOKEN=
HUE_APP_KEY=

# ── 5. Sonos ──  developer.sonos.com
SONOS_CLIENT_ID=
SONOS_CLIENT_SECRET=
SONOS_REFRESH_TOKEN=

# ── 6. Tesla ──  developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REFRESH_TOKEN=

# ── 7. Eufy (community library, uses your Eufy login) ──
EUFY_USERNAME=
EUFY_PASSWORD=

# ── 8. Roborock (community library, uses your Roborock login) ──
ROBOROCK_USERNAME=
ROBOROCK_PASSWORD=
