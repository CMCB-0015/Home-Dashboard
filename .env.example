# Panel — settings for testing in the Codespace
#
# Copy this to .env (cp .env.example .env) and fill in what you need.
# .env is never uploaded to GitHub. On the Lenovo, these settings live in the
# app's Configuration tab in Home Assistant instead.

# The code each device enters once to unlock the dashboard
PANEL_PASSCODE=

# Rachio app → Account → API Access (optional while testing)
RACHIO_API_KEY=

# The Brief's schedule-feed key, for sports chips in the status bar (optional)
BRIEF_FEED_KEY=

# Forecast location (defaults to San Clemente)
WEATHER_LAT=33.4270
WEATHER_LON=-117.6120
WEATHER_LOCATION_NAME=San Clemente

# Home Assistant: leave empty in the Codespace. The Codespace runs in the cloud
# and can't reach your house, so the Home Assistant tiles show demo data.
# (On the Lenovo the app connects to Home Assistant on its own.)
HA_URL=
HA_TOKEN=
